# NBA data
data/

# Python virtual environment
.venv/

# Python cache
__pycache__/
*.py[cod]

# Generated model files. Most artifacts under models/ are regenerated by
# src/train_baseline_model.py or src/player_impact.py and are not tracked.
# The baseline logistic model and its metrics are small, versioned reference
# artifacts that document the currently validated baseline, so they are
# tracked as an explicit exception below.
models/*
!models/baseline_logistic.pkl
!models/baseline_metrics.json

# Environment variables
.env